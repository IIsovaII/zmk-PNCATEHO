#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &pncateho_physical_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <3>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3)                    RC(0,13) RC(0,12) RC(0,11) RC(0,10)
        RC(0,4) RC(0,5) RC(0,6) RC(0,7)                    RC(0,17) RC(0,16) RC(0,15) RC(0,14)              
                                RC(0,8) RC(0,9)    RC(0,19) RC(0,18)
            >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";

        input-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 7  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    pncateho_physical_layout: pncateho_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "PNCATEHO";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys // w   h    x    y     rot rx ry
            = <&key_physical_attrs 100 100  0   0     0   0  0>
            , <&key_physical_attrs 100 100 100 0     0   0  0>
            , <&key_physical_attrs 100 100 200 0     0   0  0>
            , <&key_physical_attrs 100 100 300 0     0   0  0>
            , <&key_physical_attrs 100 100 700 0     0   0  0>
            , <&key_physical_attrs 100 100 800 0     0   0  0>
            , <&key_physical_attrs 100 100 900 0     0   0  0>
            , <&key_physical_attrs 100 100 1000 0    0   0  0>
            , <&key_physical_attrs 100 100 0 120   0   0  0>
            , <&key_physical_attrs 100 100 100 120 0   0  0>
            , <&key_physical_attrs 100 100 200 120 0   0  0>
            , <&key_physical_attrs 100 100 300 120 0   0  0>
            , <&key_physical_attrs 100 100 700 120 0   0  0>
            , <&key_physical_attrs 100 100 800 120 0   0  0>
            , <&key_physical_attrs 100 100 900 120 0   0  0>
            , <&key_physical_attrs 100 100 1000 120 0  0  0>
            , <&key_physical_attrs 100 100 50 240 0   0  0>
            , <&key_physical_attrs 100 100 150 240 0  0  0>
            , <&key_physical_attrs 100 100 750 240 0  0  0>
            , <&key_physical_attrs 100 100 850 240 0  0  0>
            ;
    };
};
